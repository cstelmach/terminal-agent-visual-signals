    {"name": "empty", "text": "", "expected": "unavailable"},
    {"name": "future-schema", "text": "SCHEMA_VERSION=\"2\"\nSUSPENDED=\"true\"\n", "expected": "unavailable"},
    {"name": "unknown-value", "text": "SCHEMA_VERSION=\"1\"\nSUSPENDED=\"TRUE\"\n", "expected": "unavailable"},
    {"name": "unquoted", "text": "SCHEMA_VERSION=1\nSUSPENDED=true\n", "expected": "unavailable"},
    {"name": "reordered", "text": "SUSPENDED=\"true\"\nSCHEMA_VERSION=\"1\"\n", "expected": "unavailable"},
    {"name": "duplicate", "text": "SCHEMA_VERSION=\"1\"\nSUSPENDED=\"true\"\nSUSPENDED=\"false\"\n", "expected": "unavailable"},
    {"name": "extra-field", "text": "SCHEMA_VERSION=\"1\"\nSUSPENDED=\"false\"\nUNKNOWN=\"value\"\n", "expected": "unavailable"},
    {"name": "no-final-newline", "text": "SCHEMA_VERSION=\"1\"\nSUSPENDED=\"false\"", "expected": "unavailable"},
